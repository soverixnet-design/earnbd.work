{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "rooms": {
      "$roomId": {
        ".validate": "newData.hasChildren(['players','turn','dice'])",
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['name','color']) && newData.child('name').isString() && newData.child('color').isString()"
          }
        }
      }
    }
  }
}
