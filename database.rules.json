{
  "rules": {
    ".read": false,
    ".write": false,
    "siteSettings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },
    "games": {
      ".read": true,
      "$gameId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".validate": "newData.hasChildren(['uid','email','referralCode']) && newData.child('uid').val() == $uid && newData.child('email').isString() && newData.child('referralCode').isString()"
      }
    },
    "referrals": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$code": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true) && newData.child('uid').val() == $uid",
          ".validate": "newData.hasChildren(['uid','name','at']) && newData.child('uid').val() == $uid && newData.child('name').isString()"
        }
      }
    },
    "leaderboards": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || !data.exists() || data.child('host').val() == auth.uid)",
        ".validate": "newData.hasChildren(['players','turn','dice'])",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
            ".validate": "newData.hasChildren(['uid','name','color']) && newData.child('uid').val() == $uid && newData.child('name').isString() && newData.child('color').isString()"
          }
        },
        "game": {
          "$key": {
            ".write": "auth != null"
          }
        },
        "actions": {
          "$actionId": {
            ".write": "auth != null && newData.child('uid').val() == auth.uid",
            ".validate": "newData.hasChildren(['id','type','uid'])"
          }
        },
        "turnUid": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || data.parent().child('players').child(auth.uid).exists())"
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "activity": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "voiceRooms": {
      "$roomId": {
        ".read": "auth != null",
        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && (newData.val() == null || newData.child('uid').val() == $uid)",
            ".validate": "newData.val() == null || (newData.hasChildren(['uid','name']) && newData.child('uid').val() == $uid && newData.child('name').isString())"
          }
        },
        "signals": {
          "$targetUid": {
            ".read": "auth != null && auth.uid == $targetUid",
            "$signalId": {
              ".write": "auth != null && ((newData.val() == null && auth.uid == $targetUid) || newData.child('from').val() == auth.uid)",
              ".validate": "newData.val() == null || (newData.hasChildren(['from','type']) && newData.child('from').isString() && newData.child('type').isString())"
            }
          }
        }
      }
    },
    "adminAudit": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    }
  }
}
