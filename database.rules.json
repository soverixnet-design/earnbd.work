{
  "rules": {
    "siteSettings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },
    "games": {
      ".read": true,
      "$gameId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "referrals": {
      ".read": "auth != null",
      "$code": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
        }
      }
    },
    "leaderboards": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "onlineRooms": {
      "$gameId": {
        "$roomId": {
          ".read": "auth != null",
          ".write": "auth != null",
          "players": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && (auth.uid == $uid || data.parent().parent().child('host').val() == auth.uid)"
            }
          },
          "events": {
            ".read": "auth != null",
            "$eventId": {
              ".write": "auth != null && (newData.val() == null || newData.child('uid').val() == auth.uid)"
            }
          }
        }
      }
    },
    "matchmaking": {
      "$gameId": {
        ".read": "auth != null",
        "queue": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "matches": {
          ".read": "auth != null",
          "$matchId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "activity": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "voiceRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "blocks": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        },
        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        },
        "signals": {
          "$targetUid": {
            ".read": "auth != null && auth.uid == $targetUid",
            "$signalId": {
              ".write": "auth != null && (newData.val() == null || newData.child('from').val() == auth.uid)"
            }
          }
        }
      }
    },
    "voiceMatchmaking": {
      "$gameId": {
        ".read": "auth != null",
        "queue": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "matches": {
          ".read": "auth != null",
          "$matchId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "adminAudit": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    }
  }
}
